---
// Cross-links to the collective's other apps, in the footer.
const projects = [
  {
    name: "Monkey Claude Usage",
    href: "https://github.com/my-monkeys/monkey-claude-usage",
    slug: "monkey-claude-usage",
    desc: "Every Claude account you own, metered in the menu bar: session, weekly and per-model limits, with a countdown once one is spent.",
    meta: "macOS · menu bar · BSD-2",
  },
  {
    name: "Monkey Battery",
    href: "https://github.com/my-monkeys/monkey-battery",
    slug: "monkey-battery",
    desc: "Below 10\u00A0%, the time your Mac really has left shows up next to the battery icon. Two minutes out, a red panel and an alarm you can't miss.",
    meta: "macOS · menu bar · BSD-2",
  },
  {
    name: "GeoDaily",
    href: "https://geodaily.eu",
    slug: "geodaily",
    desc: "A daily geography quiz, practice modes for every continent, and leaderboards to compare scores with your friends.",
    meta: "Web · daily quiz · free",
  },
  {
    name: "Glance",
    href: "https://glance-analytics.com",
    slug: "glance",
    desc: "Your Umami and Plausible analytics in one app: every site on one screen, live visitors, and charts that read at a glance.",
    meta: "iOS, Android, macOS & Windows · MIT",
  },
];
---

<div class="more">
  <p class="more-k">More from the monkeys</p>
  <div class="more-grid">
    {projects.map((p) => (
      <a
        class="more-card"
        href={p.href}
        data-umami-event="cross-project"
        data-umami-event-project={p.slug}
      >
        <span class="more-name">{p.name}<span class="more-arrow">→</span></span>
        <span class="more-desc">{p.desc}</span>
        <span class="more-meta">{p.meta}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .more { margin: 26px 0 0; }
  .more-k {
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 14px;
  }
  .more-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .more-card {
    display: block;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px 22px;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .more-card:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
    box-shadow: 0 10px 26px -16px rgba(20, 18, 16, 0.35);
  }
  .more-name {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-weight: 620;
    font-size: 1.02rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .more-arrow { color: var(--accent); font-size: 0.92rem; transition: transform 0.15s ease; }
  .more-card:hover .more-arrow { transform: translateX(3px); }
  .more-desc {
    display: block;
    margin: 7px 0 12px;
    font-size: 0.93rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .more-meta {
    display: block;
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }
  @media (max-width: 720px) {
    .more-grid { grid-template-columns: 1fr; }
  }
</style>
