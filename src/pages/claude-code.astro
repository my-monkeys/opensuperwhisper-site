---
import "../styles/global.css";
import "../styles/next.css";
import "../styles/redesign.css";
import "../styles/claude-code.css";
import MoreProjects from "../components/MoreProjects.astro";
import Support from "../components/Support.astro";
import ProductVideo from "../components/ProductVideo.astro";

// Media provenance and production details: capture-delivery/media-manifest.md.
const GH = "https://github.com/my-monkeys/OpenSuperWhisper";
const BREW = "brew install --cask my-monkeys/tap/opensuperwhisper";

const moments = [
  {
    id: "done",
    img: "/screenshots/agents/stop.png",
    alt: "Illustration of the panel with completed project search and a field to answer",
    width: 1280, height: 1000, illustrated: true,
    title: "When it finishes",
    body: "The panel shows which session it is and what Claude said last, with its formatting kept intact. Say what to do next and Claude carries on with it.",
  },
  {
    id: "permission",
    img: "/screenshots/agents/permission.png",
    alt: "The panel asking to allow pnpm build, with Allow and Deny",
    width: 1280, height: 880, illustrated: false,
    title: "When it needs your permission",
    body: "You see the command, the file or the address before anything runs. Allow it, deny it, or say what to do instead. A spoken yes or no is enough.",
  },
  {
    id: "question",
    img: "/screenshots/agents/question.png",
    alt: "The panel asking which project fields to search, with three options",
    width: 1280, height: 1200, illustrated: false,
    title: "When it asks you something",
    body: "Its options are listed to click. Saying the name of one picks it, and anything else you say goes back as your own answer.",
  },
];

const cases = [
  {
    title: "Instructions that would take a paragraph to type",
    body: "Explaining what to change next is quicker said than typed, and it comes out with the reasons you would have left out.",
  },
  {
    title: "Several sessions at once",
    body: "Each panel names its session and project. When three are waiting, arrows step through them, oldest first.",
  },
  {
    title: "Away from the keyboard",
    body: "Sketching on paper, reading a spec on the other screen, standing up. The panel is in the corner, and your voice reaches it without the terminal.",
  },
  {
    title: "Approvals that don't break your focus",
    body: "The panel opens without taking the keyboard, so whatever you are typing elsewhere keeps its keystrokes. Click into it when you are ready.",
  },
];

const faq = [
  {
    q: "What if OpenSuperWhisper isn't running?",
    a: "Nothing changes. The plugin checks for the app first, and without it Claude Code waits in its terminal exactly as it would without the plugin.",
  },
  {
    q: "What if I don't answer?",
    a: "After the wait you chose in Settings, from one to ten minutes, the request goes back to the terminal, where you can still answer it. The cross in the panel does the same at once.",
  },
  {
    q: "Does anything go to a server?",
    a: "No. The plugin and the app talk through files on your Mac, and your voice is transcribed by the engine you already use, on-device unless you chose a remote one.",
  },
  {
    q: "Which agents does it work with?",
    a: "Claude Code, and Codex since 0.13.1. Codex picks up the same plugin on its own; it gets its own switch in Settings › Agents, off until you turn it on, and asks once to trust the hooks. Codex's multiple-choice questions stay in its terminal for now.",
  },
  {
    q: "Can I keep it off for some projects?",
    a: "Yes. Settings › Agents lists every project an agent has asked from, each with its own switch, and you can turn each moment on or off.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Voice for Claude Code on Mac: answer it out loud | OpenSuperWhisper</title>
    <meta name="description" content="Answer Claude Code by voice from a panel in the corner of your Mac's screen: replies, permissions and questions, without going back to the terminal. Free, open source, on-device." />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="canonical" href="https://opensuperwhisper.com/claude-code" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://opensuperwhisper.com/claude-code" />
    <meta property="og:title" content="Talk back to Claude Code" />
    <meta property="og:description" content="Replies, permissions and questions from Claude Code, answered out loud from a panel on your Mac. Free and open source." />
    <meta property="og:image" content="https://opensuperwhisper.com/screenshots/agents/stop.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Lilita+One&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script defer src="https://uuu.my-monkey.fr/u.js" data-website-id="6734df40-5bb0-485e-a311-6ee24b1c7dc7"></script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="redesign claude-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="announcement"><a href="/">Big ideas. Out loud. <strong>Meet OpenSuperWhisper ↗</strong></a><button class="motion-toggle" type="button" aria-pressed="false">Pause animations</button></div>
    <nav class="nav" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="OpenSuperWhisper home"><img src="/icon.png" alt="" class="brand-icon" /><span>OpenSuperWhisper<span class="brand-caption">Big ideas. Out loud.</span></span></a>
      <div class="nav-links" id="navigation-links">
        <a href="#moments">How it works</a>
        <a href="#setup">Installation</a>
        <a href={GH} data-umami-event="github" data-umami-event-loc="cc-nav">GitHub ↗</a>
        <a class="btn btn-primary nav-cta" href={`${GH}/releases/latest`} data-umami-event="download-cta" data-umami-event-loc="cc-nav">Get it for free ↗</a>
      </div>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation-links">Menu <span aria-hidden="true">+</span></button>
    </nav>

    <main id="main">
      <section class="cc-hero">
        <div class="wrap cc-hero-grid">
          <div class="cc-intro">
            <p class="eyebrow cc-eyebrow">OpenSuperWhisper × Claude Code</p>
            <h1 class="display" aria-label="You talk. Claude codes."><span class="headline-line">You talk.</span><span class="headline-line coral-type">Claude</span><span class="headline-line">codes.</span></h1>
            <p class="lead">
              When Claude Code finishes, needs a permission or asks a question, OpenSuperWhisper
              shows it in a panel in the corner of your screen. Answer out loud and it carries on.
              The terminal can stay behind your other windows.
            </p>
            <div class="cc-actions">
              <a class="btn hero-download" href="#setup" data-umami-event="download-cta" data-umami-event-loc="cc-hero">Let’s team up <span aria-hidden="true">↗</span></a>
              <a class="cc-text-link" href="#moments">See it in action ↓</a>
            </div>
            <p class="cc-hero-note">Free &amp; open source · macOS 14+ · App v0.13+</p>
          </div>

          <!-- One orchestrated moment: the agent stops, the panel arrives, the answer lands. -->
          <div class="cc-stage" aria-hidden="true">
            <div class="mascot-sticker"><img src="/icon.png" alt="" width="100" height="100" /><span>Your turn, human.</span></div>
            <span class="playground-spark cc-spark">✳</span>
            <div class="cc-term">
              <div class="cc-term-bar"><i></i><i></i><i></i><span>claude</span></div>
              <pre class="cc-term-body"><span class="l1"><b>›</b> Add a search field to the project list</span>
<span class="l2"><em>⏺</em> Added search by project name.</span>
<span class="l3"><em>⏺</em> Empty state: “No projects found”.</span>
<span class="l4 dim">  Waiting for OpenSuperWhisper…</span>
<span class="l5"><em>⏺</em> Voice reply: add a clear button.</span>
<span class="l6"><em>⏺</em> Working on the next change…</span></pre>
            </div>
            <span class="cc-stage-label">Your reply, one shortcut away. · Illustrative demo</span>
            <img class="cc-panel" src="/screenshots/agents/stop.png" alt="" width="1280" height="1000" />
          </div>
        </div>
      </section>

      <div class="cc-moment-band" aria-label="Three ways to answer Claude Code">
        <a href="#done"><span>01</span> Next idea. <i aria-hidden="true">↗</i></a>
        <a href="#permission"><span>02</span> Your call. <i aria-hidden="true">↗</i></a>
        <a href="#question"><span>03</span> Just ask. <i aria-hidden="true">↗</i></a>
      </div>

      <section id="moments" class="cc-moments">
        <div class="wrap">
          <p class="eyebrow">A conversation, not a context switch</p>
          <h2 class="h2 cc-section-title">Three little interruptions.<br /><em>One easy answer.</em></h2>
          {moments.map((m, i) => (
            <article class:list={["cc-moment", { flip: i % 2 === 1 }]} id={m.id}>
              <div class="cc-moment-copy">
                <span class="cc-moment-number">0{i + 1}</span>
                <h3>{m.title}</h3>
                <p>{m.body}</p>
              </div>
              <figure class="cc-shot">
                <a href={m.img} target="_blank" rel="noopener" aria-label={`View full-size image: ${m.title}`}><img src={m.img} alt={m.alt} loading="lazy" width={m.width} height={m.height} /></a>
                {m.illustrated && <figcaption>Illustrative demo</figcaption>}
              </figure>
            </article>
          ))}
        </div>
      </section>

      <section class="cc-dictate">
        <div class="wrap cc-dictate-grid">
          <ProductVideo name="claude-reply" title="A reply, out loud" description="Illustration of the Claude Code panel: the microphone expands into a waveform, a reply is dictated, then sent and the panel closes." poster="/screenshots/agents/recording.png" width={1280} height={800} />
          <div class="cc-dictate-copy">
            <p class="eyebrow">Same shortcut. New conversation.</p>
            <h2 class="h2">A reply is just<br /><em>a breath away.</em></h2>
            <p>
              Click the microphone and it stretches into a live meter, with delete and stop on
              either side. Once the panel has focus, the trigger you already use for dictation
              answers the agent instead of typing into the app behind it.
            </p>
            <dl class="cc-keys">
              <div><dt><kbd>⏎</kbd></dt><dd>Send, or stop and send while you speak</dd></div>
              <div><dt><kbd>⇧</kbd><kbd>⏎</kbd></dt><dd>New line</dd></div>
              <div><dt><kbd>esc</kbd></dt><dd>Throw the recording away</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <section class="cc-cases">
        <div class="wrap">
          <p class="eyebrow">Room for the way you work</p>
          <h2 class="h2 cc-section-title">Less back and forth.<br /><em>More getting somewhere.</em></h2>
          <div class="cc-case-list">
            {cases.map((c, i) => (
              <div class:list={["cc-case", { "cc-case-with-video": i === 1 }]}>
                <span class="cc-case-number" aria-hidden="true">0{i + 1} /</span>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {i === 1 && <ProductVideo name="agent-sessions" title="One panel. Three conversations." description="Illustration of navigating three waiting Claude Code sessions: demo-site, notes-app and scratchpad." poster="/screenshots/agents/multiple-sessions.png" width={1280} height={1000} />}
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="setup" class="cc-setup">
        <div class="wrap cc-setup-grid">
          <div>
            <p class="eyebrow">Make the introduction</p>
            <h2 class="h2">Hello, new<br /><em>coding buddy.</em></h2>
            <ol class="cc-steps">
              <li>
                <h3>Install OpenSuperWhisper</h3>
                <p>Version 0.13 or later, from <a href={`${GH}/releases/latest`} data-umami-event="download-dmg" data-umami-event-loc="cc-setup">the latest release</a> or with Homebrew:</p>
                <div class="cc-command"><code class="cc-cmd">{BREW}</code><button class="cc-copy" type="button" aria-label="Copy Homebrew command">Copy</button></div>
              </li>
              <li>
                <h3>Add the plugin</h3>
                <p>In Settings › Agents, click Install the plugin. It goes through Claude Code's own plugin command. From a terminal, the same thing is:</p>
                <div class="cc-command"><code class="cc-cmd">claude plugin marketplace add my-monkeys/OpenSuperWhisper<br />claude plugin install opensuperwhisper@opensuperwhisper</code><button class="cc-copy" type="button" aria-label="Copy Claude Code plugin commands">Copy</button></div>
              </li>
              <li>
                <h3>Restart your Claude Code sessions</h3>
                <p>New sessions pick the plugin up on their own. The next time one stops, the panel shows up.</p>
              </li>
            </ol>
            <p class="cc-copy-status" role="status" aria-live="polite"></p>
          </div>
          <figure class="cc-shot cc-settings">
            <a href="/screenshots/agents/settings.png" target="_blank" rel="noopener" aria-label="View Agents settings full size"><img src="/screenshots/agents/settings.png" alt="Agents settings in OpenSuperWhisper 0.13.1: Answer Claude Code, three enabled events, a five-minute wait and per-project controls" loading="lazy" width="1800" height="1440" /></a>
            <figcaption>Choose which moments bring the panel up, how long it waits, and which projects use it.</figcaption>
          </figure>
        </div>
      </section>

      <section class="cc-faq">
        <div class="wrap">
          <p class="eyebrow">A few things worth asking</p>
          <h2 class="h2 cc-section-title">Good question.</h2>
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>
      <section class="cc-outro">
        <div class="wrap">
          <p class="eyebrow">Your next instruction is ready when you are</p>
          <h2 class="h2">Go on.<br /><em>Talk to your agent.</em></h2>
          <a class="btn hero-download" href={`${GH}/releases/latest`} data-umami-event="download" data-umami-event-loc="cc-bottom">Download for Mac ↗</a>
          <a class="cc-text-link" href="/">Explore all of OpenSuperWhisper →</a>
        </div>
      </section>
    </main>

    <footer class="fe">
      <div class="wrap">
        <div class="fe-head">
          <div class="fe-brand">🐵 My-Monkey</div>
          <a class="fe-univ" href="https://my-monkey.fr/projets/" data-umami-event="my-monkey-universe">Tout l'univers →</a>
        </div>
        <MoreProjects />
        <Support />
        <div class="fe-foot">
          <span>OpenSuperWhisper · MIT licensed</span>
          <a href="/">Home</a>
          <a href="/claude-code" aria-current="page">Claude Code</a>
          <a href="/changelog">Changelog</a>
          <a href={GH} data-umami-event="github" data-umami-event-loc="cc-footer">github.com/my-monkeys/OpenSuperWhisper</a>
        </div>
      </div>
    </footer>

    <script>
      import "../scripts/home-motion";
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector(".nav");
      const closeMenu = () => { toggle?.setAttribute("aria-expanded", "false"); nav?.classList.remove("menu-open"); };
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        nav?.classList.toggle("menu-open", open);
      });
      document.querySelectorAll(".nav-links a").forEach(link => link.addEventListener("click", closeMenu));
      document.addEventListener("keydown", event => { if (event.key === "Escape") closeMenu(); });
      document.querySelectorAll<HTMLButtonElement>(".cc-copy").forEach(button => {
        button.addEventListener("click", async () => {
          const command = button.parentElement!.querySelector("code")!.innerText;
          const status = document.querySelector<HTMLElement>(".cc-copy-status")!;
          try {
            await navigator.clipboard.writeText(command);
            status.textContent = "Copied. Paste the command into your terminal when you're ready.";
            button.textContent = "Copied!";
            setTimeout(() => { button.textContent = "Copy"; }, 2500);
          } catch {
            status.textContent = "Select the command and copy it manually.";
          }
        });
      });
    </script>
  </body>
</html>
